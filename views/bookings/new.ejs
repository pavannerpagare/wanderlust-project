<% layout("/layouts/boilerplate") -%>

<div class="container mt-4">
  <h2>Book <%= listing.title %></h2>

  <% if (error) { %>
    <div class="alert alert-danger">
      <%= error %>
    </div>
  <% } %>

  <p>Price per night: ₹<%= listing.price %></p>

  <form
    action="/bookings/listings/<%= listing._id %>"
    method="POST"
  >
    <div class="mb-3">
      <label for="checkIn" class="form-label">
        Check-in
      </label>

      <input
        type="date"
        id="checkIn"
        name="checkIn"
        class="form-control"
        required
      />
    </div>

    <div class="mb-3">
      <label for="checkOut" class="form-label">
        Check-out
      </label>

      <input
        type="date"
        id="checkOut"
        name="checkOut"
        class="form-control"
        required
      />
    </div>

    <div class="mb-3">
      <label for="guests" class="form-label">
        Number of guests
      </label>

      <input
        type="number"
        id="guests"
        name="guests"
        class="form-control"
        min="1"
        value="1"
        required
      />
    </div>

    <button type="submit" class="btn btn-success">
      Confirm Reservation
    </button>
  </form>
</div>